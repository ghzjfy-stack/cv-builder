OPENAI_API_KEY=sk-your-key-here
# Optional fallback for CV parse/polish if OpenAI is unset
GEMINI_API_KEY=
# CV_AI_PROVIDER=openai
# OPENAI_CV_MODEL=gpt-4o-mini
# GEMINI_CV_MODEL=gemini-2.0-flash,gemini-1.5-flash
PAYMENT_TOKEN_SECRET=replace-with-a-long-random-string
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string
PAYBOX_WEBHOOK_SECRET=replace-with-a-long-random-string
# Hosted PayBox / card page. Use {{session}} {{amount}} {{method}} placeholders.
PAYBOX_PAY_URL=
PAYBOX_CARD_URL=
# Optional PEM public key for RSA IPN signatures (Verifone-style)
# PAYBOX_PUBLIC_KEY=
PAYMENT_AMOUNT_ILS=9.9
PAYMENT_PACK_COMPLETE_ILS=19.9
COVER_LETTER_BUMP_ILS=10

# Vercel KV / Upstash Redis REST (required in production so codes survive cold starts)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

CODE_TTL_SECONDS=2592000

# WhatsApp Cloud API (preferred) — template is required to message users who have not written first
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=he

# Twilio SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email fallback (Resend)
RESEND_API_KEY=
RESEND_FROM=QuickCV <noreply@quickcv.app>

# Public site URL for SEO canonical / Open Graph tags
NEXT_PUBLIC_SITE_URL=https://quickcv.app


# Telegram order alerts (BotFather token + chat/group id). Safe to leave empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# First order is START + 1 (default #1001)
# ORDER_SEQ_START=1000
